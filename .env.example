DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Path to the service-account JSON downloaded from Firebase Console
FIREBASE_CREDENTIALS=serviceAccountKey.json

# Comma-separated emails that get the ADMIN role when they log in
ADMIN_EMAILS=admin@example.com

# Web app config (Firebase Console > Project settings > Your apps > Web)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
